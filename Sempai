body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f4f4f4;
    font-family: Arial, sans-serif;
}

.Flower {
    position: relative;
    padding: 20px;
    background: #ffcc00;
    border-radius: 10px;
    text-align: center;
    font-size: 20px;
    font-weight: bold;
    width: 200px;
}

.Flower::after {
    content: "";
    position: absolute;
    height: 15px;
    width: 250px;
    background: #a52a2a;
    top: 100%;
    left: -13%;
}

.whatsapp-button {
    display: inline-block;
    margin-top: 10px;
    padding: 8px 15px;
    background-color: #25d366;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    font-size: 14px;
}

.whatsapp-button:hover {
    background-color: #1ebe57;
}
